{
  "name": "answer-divider",
  "version": "1.0.5",
  "description": "Marks where Claude's final answer starts with a thin line, dims the interim text, and shows how long the turn took.",
  "types": "./types/index.d.ts",
  "userConfig": {
    "language": {
      "type": "string",
      "title": "Language",
      "description": "The language of the mod's words: English by default; auto follows the language you write in.",
      "default": "en",
      "options": [
        "auto",
        "en",
        "ru",
        "uk",
        "be",
        "pl",
        "de",
        "fr",
        "es",
        "it",
        "pt",
        "ja",
        "zh",
        "ko"
      ]
    }
  },
  "license": "MIT",
  "author": {
    "name": "Oleksiy"
  },
  "homepage": "https://github.com/oleksiydemidenko/claude-code-mods",
  "repository": "https://github.com/oleksiydemidenko/claude-code-mods",
  "icon": "./.claude-plugin/icon.png",
  "documentationUrl": "https://github.com/oleksiydemidenko/claude-code-mods/tree/main/answer-divider#readme",
  "supportUrl": "https://github.com/oleksiydemidenko/claude-code-mods/issues",
  "privacyPolicyUrl": "https://github.com/oleksiydemidenko/claude-code-mods/tree/main/answer-divider#privacy"
}
